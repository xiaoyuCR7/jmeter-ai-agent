# Copy to .env and uncomment what you need. Every value below shows its default.
# AI models (API keys, context windows) are added in Settings -> AI models, not here.

# Model used when a request does not name one; empty uses the first enabled model.
# DEFAULT_AI_MODEL=

# Backend port. HOST must stay a loopback address: there is no login.
# PORT=8000

# JMeter: bin directory or install root.
# JMETER_HOME=../bin
# Stops a run that never ends (s). A plan with a fixed duration longer than this
# gets its duration plus time to write the report.
# JMETER_TIMEOUT=3600
# AUTO_ANALYSIS_ENABLED=true
# JVM heap and options for local runs. A HEAP, GC_ALGO or JVM_ARGS variable in the
# backend's environment wins. Container mode uses the image's defaults.
# JMETER_HEAP_MIN=256m
# JMETER_HEAP_MAX=2g
# JMETER_GC_OPTS=-XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:G1ReservePercent=20
# JMETER_EXTRA_OPTS=
# Distributed runs: engines as host:port,host:port. RMI over SSL needs
# rmi_keystore.jks on every engine; off also passes server.rmi.ssl.disable=true.
# JMETER_REMOTE_ENGINES=
# JMETER_REMOTE_SSL_ENABLED=false

# Backend log: level, and the file (default logs/jmeter-agent.log, 5 MB x 3; "off" for console only).
# LOG_LEVEL=INFO
# LOG_FILE=
# Restart the backend on every source change (development only; ends runs in flight).
# DEBUG=false
# Stop a run once its report directory passes this size (MB); 0 = no limit.
# JMETER_MAX_OUTPUT_MB=10240

# Run guard: stops a run whose recent requests nearly all fail, or when this machine is
# nearly out of memory. LATENCY_FACTOR also stops a run whose responses take that many
# times longer than at its start (0 = off; stress tests are meant to slow the target).
# RUN_GUARD_ENABLED=true
# RUN_GUARD_ERROR_RATE=90
# RUN_GUARD_MEMORY_PERCENT=97
# RUN_GUARD_LATENCY_FACTOR=0
# Seconds to let this machine settle between unattended runs (agents, capacity steps).
# RESOURCE_COOLDOWN_SECONDS=10

# Disk: remove the HTML dashboard (about 3 MB a run) of runs that ended more than this
# many days ago; 0 keeps everything. Summaries, AI reports and history are kept, and so
# is the run an active baseline came from. INCLUDE_JTL also removes the raw results.
# REPORTS_RETENTION_DAYS=0
# REPORTS_RETENTION_INCLUDE_JTL=false

# Execution isolation. "local" runs JMeter with your privileges and asks before
# running a plan that contains scripts. "container" runs it in Docker; set an image
# you pulled yourself, pinned by digest (docker pull <image>, then
# docker image inspect --format "{{index .RepoDigests 0}}" <image>).
# JMETER_EXECUTION_MODE=local
# JMETER_CONTAINER_IMAGE=
# JMETER_CONTAINER_USER=65534:65534
# JMETER_CONTAINER_MEMORY_MB=2048
# JMETER_CONTAINER_CPUS=2.0
# Docker network for runs (empty: Docker's default bridge). Create one with
# restricted egress to reach only your targets; "host" is refused.
# JMETER_CONTAINER_NETWORK=

# Queue new runs while the load generator is above these usages (%).
# RESOURCE_CPU_THRESHOLD=80
# RESOURCE_MEMORY_THRESHOLD=85

# Context budget (tokens) for a model whose window is unknown.
# AGENT_CONTEXT_TOKEN_BUDGET=16384

# Test data uploads (bytes).
# TEST_DATA_MAX_UPLOAD_BYTES=104857600

# Webhook: POST every run's events (test.started / completed / failed / cancelled,
# analysis.completed) to this URL; use https. Set a secret: X-JMeter-Agent-Signature is
# "sha256=" + HMAC-SHA256 of "<X-JMeter-Agent-Timestamp>.<raw body>". Failed deliveries
# are retried 3 times. WEBHOOK_INCLUDE_ANALYSIS also sends the AI's full assessment.
# WEBHOOK_URL=
# WEBHOOK_SECRET=
# WEBHOOK_ON_START=true
# WEBHOOK_ON_COMPLETE=true
# WEBHOOK_ON_FAILURE=true
# WEBHOOK_ON_ANALYSIS=true
# WEBHOOK_INCLUDE_ANALYSIS=false
