# Copy to .env and uncomment what you need. Every value below shows its default.
# AI models (API keys, context windows) are added in Settings -> AI models, not here.

# Model used when a request does not name one; empty uses the first enabled model.
# DEFAULT_AI_MODEL=

# Backend port. HOST must stay a loopback address: there is no login.
# PORT=8000

# JMeter: bin directory or install root, max run time (s) and JVM heap.
# JMETER_HOME=../bin
# JMETER_TIMEOUT=3600
# JMETER_HEAP_MIN=256m
# JMETER_HEAP_MAX=2g

# Queue new runs while the load generator is above these usages (%).
# RESOURCE_CPU_THRESHOLD=80
# RESOURCE_MEMORY_THRESHOLD=85

# Context budget (tokens) for a model whose window is unknown.
# AGENT_CONTEXT_TOKEN_BUDGET=16384

# Test data uploads (bytes).
# TEST_DATA_MAX_UPLOAD_BYTES=104857600
