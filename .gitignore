# ============================================================
# Apache JMeter 运行时（第三方发行版，不入库）
# 部署时请自行下载 Apache JMeter 放到项目根目录，
# 或通过 JMETER_HOME 环境变量指定。
# ============================================================
/bin/
/lib/
/extras/
/printable_docs/
/licenses/
# JMeter 官方文档随发行版一起忽略，仅保留本项目自己的文档
/docs/*
!/docs/repairs/

# ============================================================
# 运行时产物（测试计划 / 报告 / 备份 / 向量库）
# ============================================================
/backups/
/jmeter-agent-backend/test_plans/
/jmeter-agent-backend/reports/
rag_lancedb/
/jmeter-agent-backend/uploads/
/jmeter-agent-backend/test_exec_id.txt
/jmeter-agent-backend/test_plan_id.txt
/jmeter-agent-backend/test_project_id.txt

# ============================================================
# 密钥与环境配置（绝不入库）
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
# 运行时模型配置文件（界面配置模型时生成，可能含 API Key）
/jmeter-agent-backend/ai_models_config.json
/jmeter-agent-backend/.local_access_token

# ============================================================
# 数据库与临时数据
# ============================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# 后端启动时防止重复启动的锁文件
*.startup.lock

# ============================================================
# Python
# ============================================================
__pycache__/
*.[pyc]
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# ============================================================
# Node.js / 前端构建产物
# ============================================================
node_modules/
**/dist/
# Playwright 输出
/jmeter-agent-frontend/test-results/
/jmeter-agent-frontend/playwright-report/
npm-debug.log*
yarn-error.log*

# ============================================================
# 日志
# ============================================================
*.log

# ============================================================
# AI 工具 / 编辑器 / 操作系统
# ============================================================
.codegraph/
.impeccable/
.superpowers/
.idea/
.vscode/
.DS_Store
Thumbs.db

# ============================================================
# 本地 Claude Code 配置（各人自己的预览/权限设置）
# ============================================================
/.claude/
